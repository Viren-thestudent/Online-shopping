# Environment files and local secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python-generated files and local environments
__pycache__/
*.py[cod]
.venv/
venv/
django_backend/venv/

# Frontend dependencies and build output
node_modules/
dist/
frontend/dist/

# Runtime-uploaded media should use durable storage in production. The existing
# product photos are source assets and must remain visible for deployment.
django_backend/media/*
!django_backend/media/products/
!django_backend/media/products/*
django_backend/staticfiles/

# Local/editor files
.pytest_cache/
.coverage
.vscode/
.idea/
*.log

# Local editor/archive bundles; keep these out of Git history
.vscode.zip
*.zip
*.7z
*.rar
*.tar
*.tar.gz
