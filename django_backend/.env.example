# Local development defaults. Keep real values in django_backend/.env only.
DJANGO_SECRET_KEY=replace-with-a-local-only-secret
DJANGO_DEBUG=True

# Omit DATABASE_URL to use django_backend/db.sqlite3 locally.
# Set it only when intentionally using a local PostgreSQL database.
DATABASE_URL=

# Comma-separated hostnames; include custom domains when used in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins. Do not include a trailing slash.
FRONTEND_URL=http://localhost:5173

# Optional. Leave unset for django_backend/media.
MEDIA_ROOT=
